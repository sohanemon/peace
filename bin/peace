#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

usage() {
  cat <<'HELP'
Usage: peace <action> [options]
  Actions: listen, pause, stop, status, wallpaper, random, next, prev, help
HELP
}

if (($# == 0)); then usage; exit 0; fi
action="$1"
shift
case "$action" in
  help|-h|--help) usage; exit 0 ;;
  __follow) exec "$SCRIPT_DIR/peace-listen" __follow "$@" ;;
  listen) exec "$SCRIPT_DIR/peace-listen" "$@" ;;
  pause|stop|status)
    PEACE_COMMAND_NAME="peace-$action" exec "$SCRIPT_DIR/peace-listen" "$@"
    ;;
  wallpaper|random|next|prev)
    if [[ $action != wallpaper ]]; then set -- "$action" "$@"; fi
    if [[ -x $HOME/.local/bin/peace-wallpaper ]]; then exec "$HOME/.local/bin/peace-wallpaper" "$@"; fi
    echo "peace: peace-wallpaper is unavailable; install the Peace theme first" >&2
    exit 1
    ;;
  init|uninstall|enable|disable|logs)
    command_path="$HOME/.local/bin/peace-$action"
    if [[ -x $command_path ]]; then exec "$command_path" "$@"; fi
    echo "peace: theme action '$action' is unavailable; install the Peace theme first" >&2
    exit 1
    ;;
  *) echo "peace: unknown action '$action'" >&2; usage >&2; exit 2 ;;
esac
