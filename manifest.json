{
  "schemaVersion": 1,
  "id": "io.github.sohanemon.omapeace",
  "name": "Omapeace",
  "version": "0.1.0",
  "author": "sohanemon",
  "license": "MIT",
  "description": "Listen to Quran recitation and follow ayah wallpapers from the Omarchy bar",
  "kinds": ["bar-widget"],
  "entryPoints": {"barWidget": "BarWidget.qml"},
  "barWidget": {
    "displayName": "Omapeace",
    "description": "Open Peace listening controls",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right"
  },
  "settings": {
    "translation": {
      "type": "string",
      "default": "20",
      "description": "Selected Quran.com translation ID"
    },
    "wbwLanguage": {
      "type": "string",
      "default": "en",
      "description": "Selected word-by-word meaning language"
    }
  }
}
